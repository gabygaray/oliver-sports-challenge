PORT=3080
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5433
DB_USER=oliver
DB_PASSWORD=oliver
DB_NAME=oliver

# Any OpenAI-compatible chat completions API. Defaults target Gemini; Groq, OpenRouter and Ollama work too.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
# Fallback when the free-tier quota of gemini-3.5-flash runs out: AI_MODEL=gemini-3.5-flash-lite with AI_REASONING_EFFORT=low (lite rejects "none").
AI_MODEL=gemini-3.5-flash
AI_TIMEOUT_MS=30000
AI_REASONING_EFFORT=none
# Reasoning tokens count against max_tokens on Gemini; while reasoning is on, this much is added on top of the prose limit (800).
AI_REASONING_TOKENS_ALLOWANCE=1500
